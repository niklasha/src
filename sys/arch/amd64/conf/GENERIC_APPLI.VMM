#	$OpenBSD: GENERIC.MP,v 1.14 2018/07/13 05:25:24 tb Exp $

include "arch/amd64/conf/GENERIC_APPLI.MP"

option	HZ=2000

option	ACPI_DEBUG
option	ACPI_MEMDEBUG

# M2: in-kernel virtio-9p guest client (host bind-mount share)
vio9p*	at virtio?	# Virtio 9P transport
option	VIO9PFS		# virtio-9p guest filesystem
