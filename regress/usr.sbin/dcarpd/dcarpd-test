# Run dcarpd(8) as master and backup on one host, in routing domains
# joined by veb(4).  No physical interface is involved.
#
#   veb77, the carp net (the master's DHCP-provisioned uplink):
#	rdomain 78  master	carp78 on vport78
#	rdomain 77  backup	carp77 on vport77
#	rdomain 76  attacker	vport76, records and replays messages
#   veb79, an internal net between the nodes:
#	rdomain 77  backup	vport79 with the default route, and a second
#				carp(4), carp79, whose state changes must be
#				ignored
#	rdomain 78  master	vport89
#
# The three-members test adds a second backup:
#	rdomain 75  third	carp75 on vport75 on veb77, vport85 on veb79
#
# fake-dhcpleased plays dhcpleased(8)'s control socket for the tests of
# the DHCP lease.
#
# The Makefile skips the test when any of these interfaces exist.
#
# usage: dcarpd-test state-file | gateway-from-route | other-carp | log-live |
#	 replay | tampered | wrong-key | encrypted | sync-interface |
#	 periodic | address-change | split-brain | address-follow |
#	 older-generation | lower-priority | equal-priority | init-takes |
#	 no-address | backup-follows-master | three-members |
#	 backup-gateway-kept | stale | restore-address | restore-on-start |
#	 state-generation | address-generation | renew | lease-time |
#	 lease-size | lease-silent | lease-future | renew-ahead |
#	 restore-address-v4 | restore-master | lease-other | restore-on-up |
#	 replace-on-backup | sigint | start-fails | desync | reject-repeat |
#	 start-errors | state-retry | carp-copies | key-mode | second-daemon |
#	 short-messages | interface-gone | two-addresses | other-rdomain

: ${OBJDIR?} ${DCARPD?} ${REPLAY?} ${LEASED?}

RA=76			# attacker rdomain
RB=77			# backup rdomain
RM=78			# master rdomain
RT=75			# third member's rdomain
VHID=177
PREFIX=10.77.0		# carp net
INTERNAL=10.79.0	# internal net
MAX_AGE=30		# DCARP_MAX_AGE in dcarpd.h
INTERFACES="carp$RB carp$RM carp$RT carp79 carp88 veb77 veb79 vether77
    vport$RT vport76 vport77 vport78 vport79 vport85 vport89"

KEY=$OBJDIR/dcarp.key
HOOK=$OBJDIR/dcarpd-hook
BLOG=$OBJDIR/dcarpd-$1-backup.log
MLOG=$OBJDIR/dcarpd-$1-master.log
TLOG=$OBJDIR/dcarpd-$1-third.log
BSTATE=$OBJDIR/dcarpd-$1-backup.state
MSTATE=$OBJDIR/dcarpd-$1-master.state
TSTATE=$OBJDIR/dcarpd-$1-third.state
MSG=$OBJDIR/dcarpd-$1.msg
DIR=$OBJDIR/dcarpd-$1.dir		# a directory of the test's own
# fake-dhcpleased's control socket.  Not in OBJDIR: sun_path holds 104
# bytes, too few for a deep obj directory and a long test name.
SOCKDIR=$(mktemp -d /tmp/dcarpd-test.XXXXXXXXXX) || exit 1
trap 'rm -rf $SOCKDIR' EXIT
CTL=$SOCKDIR/control.sock
LEASE=$OBJDIR/dcarpd-$1.lease		# the lease it reports
FLOG=$OBJDIR/dcarpd-$1-dhcpleased.log	# the requests it got

cleanup() {
	for p in $bpid $cpid $mpid $tpid $fpid; do
		kill -CONT $p 2>/dev/null	# desync stops one
		kill $p 2>/dev/null
		retry_for 5 exited $p || kill -KILL $p 2>/dev/null
		wait $p 2>/dev/null
	done
	bpid=
	cpid=
	mpid=
	tpid=
	fpid=
	rm -f $CTL
	[ -z "$leasefile" ] || rm -f $leasefile
	leasefile=
	for i in $INTERFACES; do
		ifconfig $i destroy 2>/dev/null
	done
	# Not ifconfig lo$RB alone, which would create it
	! ifconfig lo$RB >/dev/null 2>&1 ||
	    ifconfig lo$RB -alias 127.0.0.2 2>/dev/null
	rm -rf $DIR
	chmod 600 $KEY 2>/dev/null
}

fail() {
	echo "FAILED: $*"
	cleanup
	echo "--- backup dcarpd log"
	cat $BLOG 2>/dev/null
	echo "--- master dcarpd log"
	cat $MLOG 2>/dev/null
	if [ -s $TLOG ]; then
		echo "--- third dcarpd log"
		cat $TLOG
	fi
	exit 1
}

run() {
	"$@" || fail "$*"
}

# Retry the command given after the count once a second, count times.
retry_for() {
	n=$1
	shift
	while [ $n -gt 0 ]; do
		"$@" && return 0
		sleep 1
		n=$((n - 1))
	done
	return 1
}

retry() {
	retry_for 10 "$@"
}

carp_is() {	# $1 = interface, $2 = state
	[ "$(ifconfig $1 | sed -n 's/.*carp: \([A-Z]*\) .*/\1/p')" = $2 ]
}

demote() {	# $1 = group
	ifconfig -g $1 | sed -n 's/.*carp demote count \([0-9]*\).*/\1/p'
}

demote_is() {	# $1 = group, $2 = count
	[ "$(demote $1)" = $2 ]
}

defroute() {	# $1 = rdomain, the backup's by default
	route -T ${1:-$RB} -n show -inet | awk '$1 == "default" { print $2 }'
}

route_is() {	# $1 = gateway, $2 = rdomain
	[ "$(defroute $2)" = "$1" ]
}

# A variable from a state file, sourced as ifstated(8) scripts would
state() {	# $1 = variable, $2 = state file, the backup's by default
	(. ${2:-$BSTATE} 2>/dev/null && eval echo "\$$1")
}

gateway_is() {	# $1 = backup gateway held: the master's -g, $2 = state file
	[ "$(state DCARP_BACKUP_GATEWAY $2)" = $1 ]
}

# The routes the -x hook set, from its log next to the state file
hook_log() {	# $1 = state file
	echo $(cat ${1%.state}.hook 2>/dev/null)
}

# The sender id a dcarpd logged when it sent
sender() {	# $1 = log
	sed -n 's/^sent .*(sender \([0-9a-f]*\) .*/\1/p' $1 | tail -1
}

addresses() {	# $1 = interface
	echo $(ifconfig $1 | awk '$1 == "inet" { print $2 }')
}

only_address() {	# $1 = interface, $2 = address
	[ "$(addresses $1)" = $2 ]
}

# Whether a process has exited: gone, or a zombie not waited for yet
exited() {	# $1 = pid
	st=$(ps -o stat= -p $1 2>/dev/null)
	[ -z "$st" ] || [ "${st#Z}" != "$st" ]
}

listening() {	# $1 = pid
	fstat -p $1 2>/dev/null | grep -q ':3522'
}

vport() {	# $1 = interface, $2 = rdomain, $3 = veb, $4 = address or ""
	run ifconfig $1 create
	run ifconfig $1 rdomain $2
	[ -n "$4" ] && run ifconfig $1 inet $4
	run ifconfig $1 up
	run ifconfig $3 add $1
}

mkcarp() {	# $1 = if, $2 = rdomain, $3 = carpdev, $4 = vhid, $5 = advskew,
		# $6 = address
	run ifconfig $1 create
	run ifconfig $1 rdomain $2
	run ifconfig $1 carpdev $3 vhid $4 pass dcarpd-regress advskew $5
	run ifconfig $1 inet $6 up
}

setup() {	# $1 = "default" to give the backup an internal default route
	run ifconfig veb77 create
	run ifconfig veb77 up
	run ifconfig veb79 create
	run ifconfig veb79 up
	vport vport$RA $RA veb77 $PREFIX.$RA/24
	vport vport$RB $RB veb77 ""
	vport vport$RM $RM veb77 ""
	vport vport79 $RB veb79 $INTERNAL.1/24
	vport vport89 $RM veb79 $INTERNAL.2/24
	if [ "$1" = default ]; then
		run route -T $RB -qn add default $INTERNAL.254
	fi

	mkcarp carp$RM $RM vport$RM $VHID 0 $PREFIX.77/24
	retry carp_is carp$RM MASTER || fail "carp$RM did not become MASTER"
	mkcarp carp$RB $RB vport$RB $VHID 100 $PREFIX.77/24
	mkcarp carp79 $RB vport79 179 0 $INTERNAL.79/24
	retry carp_is carp$RB BACKUP || fail "carp$RB did not become BACKUP"
	retry carp_is carp79 MASTER || fail "carp79 did not become MASTER"

	(umask 077; echo dcarpd-regress-key > $KEY && chmod 600 $KEY) ||
	    fail "cannot write $KEY"
	# A -x hook routing as ifstated-dcarpd.conf does, logging each route
	cat > $HOOK <<-'EOF' || fail "cannot write $HOOK"
	#!/bin/sh
	. "$1" || exit 1
	case $2 in
	MASTER)	gw=$DCARP_GATEWAY;;
	BACKUP)	gw=$DCARP_BACKUP_GATEWAY;;
	*)	gw=;;
	esac
	echo "$2/${gw:-none}" >> "${1%.state}.hook"
	[ -n "$gw" ] || exit 0
	route -qn delete default >/dev/null 2>&1
	route -qn add default $gw
	EOF
	run chmod 755 $HOOK
	: > $BLOG
	: > $MLOG
	: > $TLOG
	: > $FLOG
	rm -f $MSG $BSTATE* $MSTATE* $TSTATE* ${BSTATE%.state}.hook \
	    ${MSTATE%.state}.hook ${TSTATE%.state}.hook $CTL $LEASE*
}

# A third member, a backup with a worse priority than the backup.
setup_third() {
	vport vport$RT $RT veb77 ""
	vport vport85 $RT veb79 $INTERNAL.3/24
	mkcarp carp$RT $RT vport$RT $VHID 150 $PREFIX.77/24
	retry carp_is carp$RT BACKUP || fail "carp$RT did not become BACKUP"
}

# Every dcarpd asks fake-dhcpleased, if it runs, for the DHCP lease, not
# the host's dhcpleased(8).
start_third() {		# extra dcarpd arguments
	route -T $RT exec $DCARPD -d -v -i carp$RT -g $INTERNAL.3 -k $KEY \
	    -f $TSTATE -c $CTL "$@" > $TLOG 2>&1 &
	tpid=$!
	retry listening $tpid || fail "third dcarpd did not start"
	# Logged once it handles signals, after the bind
	retry grep -q "carp$RT is in [A-Z]* state" $TLOG ||
	    fail "third dcarpd did not report its state"
}

start_backup() {	# extra dcarpd arguments
	route -T $RB exec $DCARPD -d -v -i carp$RB -g $PREFIX.250 -k $KEY \
	    -f $BSTATE -c $CTL "$@" > $BLOG 2>&1 &
	bpid=$!
	retry listening $bpid || fail "backup dcarpd did not start"
	# Logged once it handles signals, after the bind
	retry grep -q "carp$RB is in [A-Z]* state" $BLOG ||
	    fail "backup dcarpd did not report its state"
}

stop_backup() {
	kill $bpid 2>/dev/null || fail "backup dcarpd died"
	wait $bpid 2>/dev/null
	bpid=
	grep -q "carp$RB is in BACKUP state" $BLOG ||
	    fail "backup dcarpd did not see carp$RB as BACKUP"
}

# Run a master dcarpd, which distributes its configuration when it starts,
# and wait until the backup holds its -g, the given gateway, as backup
# gateway.  The tests use different -g to tell masters apart.
master() {	# $1 = -g, then extra dcarpd arguments
	gw=$1
	shift
	echo "--- master -g $gw $*" >> $MLOG
	route -T $RM exec $DCARPD -d -v -i carp$RM -g $gw -k $KEY -f $MSTATE \
	    -c $CTL "$@" >> $MLOG 2>&1 &
	mpid=$!
	retry gateway_is $gw
	ok=$?
	kill $mpid 2>/dev/null
	wait $mpid 2>/dev/null
	mpid=
	return $ok
}

# Start a master dcarpd that keeps running, for its periodic resends.
start_master() {	# $1 = gateway, then extra dcarpd arguments
	gw=$1
	shift
	echo "--- master -g $gw $*" >> $MLOG
	route -T $RM exec $DCARPD -d -v -i carp$RM -g $gw -k $KEY -f $MSTATE \
	    -c $CTL "$@" >> $MLOG 2>&1 &
	mpid=$!
	retry listening $mpid || fail "master dcarpd did not start"
}

stop_master() {
	kill $mpid 2>/dev/null || fail "master dcarpd died"
	wait $mpid 2>/dev/null
	mpid=
}

# Record the next message on the carp net from the attacker's rdomain.
capture() {
	route -T $RA exec $REPLAY -i vport$RA capture $MSG &
	cpid=$!
	retry listening $cpid || fail "dcarp-replay did not start"
}

wait_capture() {
	wait $cpid || fail "no message captured"
	cpid=
}

# Send the recorded message from the attacker's rdomain.
replay() {	# extra dcarp-replay arguments
	run route -T $RA exec $REPLAY -i vport$RA "$@" send $MSG
}

rejected() {	# $1 = source address, $2 = reason (regular expression),
		# $3 = log, the backup's by default
	grep -q "rejected message from $1: $2" ${3:-$BLOG}
}

# Whether a log has more lines matching than it had.  Not in $n, which
# retry_for changes.
logged_more() {	# $1 = regular expression, $2 = log, $3 = lines before
	[ $(grep -c "$1" $2) -gt $3 ]
}

generation_is() {	# $1 = generation, $2 = state file, the backup's by default
	[ "$(state DCARP_GENERATION $2)" = "$1" ]
}

# A state file held from before, as dcarpd writes it
statefile() {	# $1 = state file, $2 = address, $3 = generation
	printf '%s\n' "# $1, written by dcarpd-test" "DCARP_INTERFACE=" \
	    "DCARP_ADDRESS=$2" "DCARP_NETMASK=255.255.255.0" "DCARP_GATEWAY=" \
	    "DCARP_BACKUP_GATEWAY=" "DCARP_GENERATION=$3" > $1 ||
	    fail "cannot write $1"
}

# The DHCP lease fake-dhcpleased reports, replaced atomically
lease() {	# $1 = state, $2 = address, $3 = netmask, $4 = lease time,
		# $5 = when acknowledged, seconds since the epoch
	printf 'state %s\naddress %s\nnetmask %s\nlease %s\nacked %s\n' \
	    "$@" > $LEASE.new && mv $LEASE.new $LEASE ||
	    fail "cannot write $LEASE"
}

start_dhcpleased() {
	$LEASED -f $LEASE -l $FLOG -s $CTL &
	fpid=$!
	retry test -S $CTL || fail "fake-dhcpleased did not start"
}

stop_dhcpleased() {
	kill $fpid 2>/dev/null || fail "fake-dhcpleased died"
	wait $fpid 2>/dev/null
	fpid=
	rm -f $CTL
}

# Leave no interfaces, processes or files behind when interrupted
trap 'cleanup; exit 1' HUP INT TERM

case $1 in
state-file)
	# The backup writes each configuration a master announces to its
	# state file, which a shell can source, and never changes a route:
	# those are ifstated(8)'s.
	setup default
	start_backup
	master $PREFIX.254 || fail "gateway not changed to $PREFIX.254"
	master $PREFIX.253 || fail "gateway not changed to $PREFIX.253"
	stop_backup
	[ "$(state DCARP_INTERFACE) $(state DCARP_ADDRESS) $(state DCARP_NETMASK) $(state DCARP_BACKUP_GATEWAY) $(state DCARP_GENERATION)" = \
	    "carp$RB $PREFIX.77 255.255.255.0 $PREFIX.253 0" ] ||
	    fail "state file: $(cat $BSTATE)"
	# The master has no default route through carp, so no gateway
	[ -z "$(state DCARP_GATEWAY)" ] || fail "state file: $(cat $BSTATE)"
	# A master keeps the backup gateway it learned, not its own -g
	[ -z "$(state DCARP_BACKUP_GATEWAY $MSTATE)" ] ||
	    fail "master's state file: $(cat $MSTATE)"
	[ "$(stat -f %Sp $BSTATE)" = "-rw-r--r--" ] ||
	    fail "state file mode $(stat -f %Sp $BSTATE)"
	[ -z "$(ls $BSTATE.* 2>/dev/null)" ] ||
	    fail "temporary files left: $(ls $BSTATE.*)"
	route_is $INTERNAL.254 ||
	    fail "backup's default route changed to $(defroute)"
	grep -q "wrote $BSTATE: .* backup gateway $PREFIX.253" $BLOG ||
	    fail "state file write not logged"
	! grep -q SIOCAIFADDR $BLOG || fail "address configuration failed"
	;;
gateway-from-route)
	# The master announces the gateway of its default route through the
	# carp interface, as dhcpleased(8) adds one from the lease, and its
	# -g as backup gateway.  The backup, which has no default route,
	# gets none from dcarpd.
	setup
	run route -T $RM -qn add default $PREFIX.254
	start_backup
	master $INTERNAL.2 || fail "backup gateway $INTERNAL.2 not held"
	stop_backup
	[ "$(state DCARP_GATEWAY)" = $PREFIX.254 ] ||
	    fail "gateway $PREFIX.254 of the master's default route not held: $(cat $BSTATE)"
	[ -z "$(defroute)" ] || fail "backup got a default route $(defroute)"
	[ "$(state DCARP_GATEWAY $MSTATE)" = $PREFIX.254 ] ||
	    fail "master's state file: $(cat $MSTATE)"
	;;
other-carp)
	# A state change of another carp(4) does not change our state:
	# the backup still applies the master's configuration afterwards.
	setup default
	start_backup
	run ifconfig carp79 state backup
	retry carp_is carp79 BACKUP || fail "carp79 did not become BACKUP"
	retry carp_is carp79 MASTER || fail "carp79 did not return to MASTER"
	master $PREFIX.252 ||
	    fail "backup ignored the master after carp79 changed state"
	stop_backup
	! grep -q "CARP state changed" $BLOG ||
	    fail "state change of carp79 taken as our own"
	;;
log-live)
	# With -d the log shows up while dcarpd runs, not when it exits.
	setup default
	start_backup
	retry grep -q "carp$RB is in BACKUP state" $BLOG ||
	    fail "log not written while dcarpd runs"
	stop_backup
	;;
replay)
	# A recorded message sent again after a newer one is rejected.
	setup default
	start_backup
	capture
	master $PREFIX.254 || fail "gateway not changed to $PREFIX.254"
	wait_capture
	master $PREFIX.253 || fail "gateway not changed to $PREFIX.253"
	replay
	sleep 2
	gateway_is $PREFIX.253 ||
	    fail "replayed message changed the gateway to $(state DCARP_BACKUP_GATEWAY)"
	stop_backup
	rejected $PREFIX.$RA "replay: " || fail "replay not logged"
	;;
tampered)
	# A message with a changed byte in the encrypted gateway field is
	# rejected.  The wire format is a 24 byte nonce and the encrypted
	# message, in which the gateway is at offset 12.
	setup default
	start_backup
	capture
	master $PREFIX.254 || fail "gateway not changed to $PREFIX.254"
	wait_capture
	replay -x 36
	sleep 2
	gateway_is $PREFIX.254 ||
	    fail "tampered message changed the gateway to $(state DCARP_BACKUP_GATEWAY)"
	stop_backup
	rejected $PREFIX.$RA "authentication failed" ||
	    fail "tampered message not logged"
	;;
wrong-key)
	# A master with another key is rejected.
	setup default
	(umask 077; echo another-key > $KEY.other) || fail "cannot write key"
	start_backup
	! master $PREFIX.254 -k $KEY.other ||
	    fail "message with another key changed the gateway"
	stop_backup
	rejected $PREFIX.77 "authentication failed" ||
	    fail "message with another key not logged"
	;;
encrypted)
	# Neither the carp address nor the gateway is visible on the wire.
	setup default
	start_backup
	capture
	master $PREFIX.254 || fail "gateway not changed to $PREFIX.254"
	wait_capture
	stop_backup
	hex=$(od -An -tx1 -v $MSG | tr -d ' \n')
	case $hex in
	*0a4d004d*)	fail "carp address 10.77.0.77 in clear text: $hex";;
	*0a4d00fe*)	fail "gateway 10.77.0.254 in clear text: $hex";;
	esac
	[ ${#hex} -eq 208 ] || fail "captured ${#hex} hex digits, expected 208"
	;;
sync-interface)
	# With -s only messages on the sync interface are accepted.
	setup default
	start_backup -s vport79
	! master $PREFIX.254 || fail "message on carp$RB accepted with -s vport79"
	master $PREFIX.253 -s vport89 || fail "message on vport79 not accepted"
	stop_backup
	rejected $PREFIX.77 "received on carp$RB, not on vport79" ||
	    fail "message on the wrong interface not logged"
	;;
periodic)
	# A backup that starts after the master's first message gets the
	# configuration from a resend, and applies it only once.
	setup default
	start_master $PREFIX.254
	sleep 2
	start_backup
	retry_for 15 gateway_is $PREFIX.254 ||
	    fail "backup did not get the configuration from a resend"
	sleep 21	# two more resends
	stop_backup
	stop_master
	n=$(grep -c "wrote $BSTATE: .* backup gateway $PREFIX.254" $BLOG)
	[ $n -eq 1 ] || fail "configuration taken $n times, not once"
	grep -q "Backup Gateway: $PREFIX.254, unchanged" $BLOG ||
	    fail "no unchanged resend seen by the backup"
	grep -q "resent unchanged configuration" $MLOG ||
	    fail "master did not resend"
	;;
address-change)
	# When the master's address changes, the master sends it without
	# waiting for the next resend.  Changing the address sends carp(4)
	# through INIT, so this happens when it is master again, after
	# about three seconds, and the master must not try to send while
	# carp is in INIT.  Wait for a resend first, so that the next one is
	# ten seconds away.
	setup default
	start_master $PREFIX.254
	retry_for 15 grep -q "resent unchanged configuration" $MLOG ||
	    fail "master did not resend"
	run ifconfig carp$RM inet $PREFIX.78/24
	retry_for 6 grep -q "sent $PREFIX.78 netmask" $MLOG ||
	    fail "new address not sent before the next resend"
	! grep -q "sendto failed" $MLOG || fail "master sent while not master"
	stop_master
	;;
split-brain)
	# Both nodes master, with different addresses: carp(4)
	# authenticates the virtual addresses, so each discards the other's
	# advertisements.  Cut the backup off, change the master's address,
	# wait until the backup has become master, and reconnect it.  The
	# backup must take the newer configuration from the master's next
	# resend although it is master, keep no old address, and return to
	# backup; the master must reject the backup's older configuration.
	setup default
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	run ifconfig veb77 del vport$RB
	run ifconfig carp$RM inet $PREFIX.78/24
	retry carp_is carp$RB MASTER || fail "cut off carp$RB did not become MASTER"
	retry carp_is carp$RM MASTER || fail "carp$RM did not become MASTER again"
	run ifconfig veb77 add vport$RB
	retry_for 15 only_address carp$RB $PREFIX.78 ||
	    fail "carp$RB has $(addresses carp$RB), not only $PREFIX.78"
	retry carp_is carp$RB BACKUP || fail "carp$RB did not return to BACKUP"
	stop_backup
	stop_master
	grep -q "Backup Gateway: $PREFIX.254, taking it although not backup" $BLOG ||
	    fail "backup did not take the configuration as master"
	rejected $PREFIX.77 "older configuration" $MLOG ||
	    fail "master did not reject the backup's older configuration"
	;;
address-follow)
	# carp(4) authenticates the virtual addresses, so when the master's
	# address changes the backup discards its advertisements and may
	# become master before the new address reaches it.  Whichever wins
	# that race, the backup must take the new address, keep no old one,
	# and return to backup.
	setup default
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	run ifconfig carp$RM inet $PREFIX.78/24
	retry_for 15 only_address carp$RB $PREFIX.78 ||
	    fail "carp$RB has $(addresses carp$RB), not only $PREFIX.78"
	sleep 5
	state=$(ifconfig carp$RB | sed -n 's/.*carp: \([A-Z]*\) .*/\1/p')
	[ "$state" = BACKUP ] ||
	    fail "carp$RB is $state after the master's address changed"
	stop_backup
	stop_master
	;;
older-generation)
	# A configuration older than the one held is rejected.  Here a
	# master restarted without its state file, generation 0, sends
	# another gateway after the backup took a new address of a later
	# generation.  The same rule keeps a backup that has briefly become
	# master from giving the old address back to the master.
	setup default
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	run ifconfig carp$RM inet $PREFIX.78/24
	retry_for 15 only_address carp$RB $PREFIX.78 ||
	    fail "carp$RB has $(addresses carp$RB), not only $PREFIX.78"
	stop_master
	rm -f $MSTATE
	start_master $PREFIX.253
	sleep 3
	gateway_is $PREFIX.254 ||
	    fail "older configuration changed the gateway to $(state DCARP_BACKUP_GATEWAY)"
	sed -n "/^--- master -g $PREFIX.253/,\$p" $MLOG |
	    grep -q "^generation 0: " ||
	    fail "master restarted without its state file not at generation 0"
	stop_backup
	stop_master
	rejected $PREFIX.78 "older configuration" ||
	    fail "older configuration not logged"
	;;
lower-priority)
	# Within one generation, a master rejects a sender of lower carp(4)
	# priority: a backup forced to master does not impose its
	# configuration on the master.
	setup default
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	run ifconfig carp$RB state master
	sleep 3
	gw=$(state DCARP_BACKUP_GATEWAY $MSTATE)
	[ -z "$gw" ] || fail "master took the backup's -g $gw"
	stop_backup
	stop_master
	grep -q "rejected message from $PREFIX.77: configuration .* no better priority" $MLOG ||
	    fail "lower priority not logged by the master"
	;;
equal-priority)
	# Two masters of the same priority, that see each other's messages
	# on the sync net but not each other's carp(4) advertisements on the
	# split carp net: the lower sender id wins.  The other takes its
	# configuration, although master, and it rejects the other's.
	setup default
	run ifconfig carp$RB advskew 0
	start_backup -s vport79
	start_master $PREFIX.254 -s vport89
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	run ifconfig veb77 del vport$RB
	retry carp_is carp$RB MASTER || fail "cut off carp$RB did not become MASTER"
	retry grep -q "^sent " $BLOG || fail "backup did not send as master"
	b=$(sender $BLOG)
	m=$(sender $MLOG)
	[ -n "$b" -a -n "$m" ] || fail "sender ids not logged: '$b' '$m'"
	if expr $b \< $m >/dev/null; then
		winner=$BLOG loser=$MLOG
	else
		winner=$MLOG loser=$BLOG
	fi
	# The backup sent when it became master, the master resends within
	# ten seconds.
	retry_for 15 grep -q "taking it although not backup" $loser ||
	    fail "sender $m or $b with the higher id did not take the configuration"
	retry_for 15 grep -q "rejected message from .*: configuration .* no better priority" $winner ||
	    fail "sender with the lower id did not reject the configuration"
	! grep -q "taking it although not backup" $winner ||
	    fail "sender with the lower id took the configuration"
	carp_is carp$RM MASTER || fail "carp$RM is no longer MASTER"
	carp_is carp$RB MASTER || fail "carp$RB is no longer MASTER"
	stop_backup
	stop_master
	;;
init-takes)
	# A member without an address stays in INIT, sends nothing, and
	# takes the master's configuration of the same generation even if
	# its priority is better: here the master's advskew is worse.
	# carp(4) takes the interface down with its last address; up, as
	# with "inet autoconf" before a lease, it receives multicast.
	setup default
	run ifconfig carp$RB $PREFIX.77 delete
	run ifconfig carp$RB up
	run ifconfig carp$RB advskew 0
	run ifconfig carp$RM advskew 50
	retry carp_is carp$RB INIT || fail "carp$RB without an address not INIT"
	start_backup
	start_master $PREFIX.254
	retry only_address carp$RB $PREFIX.77 ||
	    fail "carp$RB in INIT did not take $PREFIX.77: $(addresses carp$RB)"
	gateway_is $PREFIX.254 || fail "state file: $(cat $BSTATE)"
	stop_master
	kill $bpid 2>/dev/null || fail "backup dcarpd died"
	wait $bpid 2>/dev/null
	bpid=
	grep -q "carp$RB is in INIT state" $BLOG ||
	    fail "backup dcarpd did not see carp$RB as INIT"
	;;
no-address)
	# A member whose carp interface has no IPv4 address takes the
	# configuration of a master that has one, also as master and of
	# better priority: without its address carp(4) neither elects it
	# nor lets it serve.  Here the backup, of better priority than the
	# master once that has advskew 200 (no preemption), is cut off,
	# becomes master, and loses its address; its IPv6 link-local address
	# keeps it up and master.  dcarpd changes no carp demote count.
	setup default
	carpbefore=$(demote carp)
	allbefore=$(demote all)
	# An address added sends carp through INIT: wait for each election
	run ifconfig carp$RM inet6 eui64
	retry carp_is carp$RM MASTER || fail "carp$RM not MASTER again"
	run ifconfig carp$RB inet6 eui64
	sleep 5
	run ifconfig carp$RM advskew 200
	sleep 2
	retry carp_is carp$RM MASTER && carp_is carp$RB BACKUP ||
	    fail "carp$RM and carp$RB are not MASTER and BACKUP"
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	run ifconfig veb77 del vport$RB
	retry carp_is carp$RB MASTER || fail "cut off carp$RB did not become MASTER"
	run ifconfig carp$RB $PREFIX.77 delete
	sleep 1
	[ -z "$(addresses carp$RB)" ] ||
	    fail "master carp$RB put $(addresses carp$RB) back"
	run ifconfig veb77 add vport$RB
	retry_for 15 only_address carp$RB $PREFIX.77 ||
	    fail "carp$RB without an address did not take $PREFIX.77: $(addresses carp$RB)"
	demote_is carp $carpbefore || fail "group carp demoted: $(demote carp)"
	demote_is all $allbefore || fail "group all demoted: $(demote all)"
	stop_backup
	stop_master
	grep -q "taking it although not backup" $BLOG ||
	    fail "taking the configuration as master not logged"
	! grep -q "demot" $BLOG || fail "backup dcarpd demoted: $(grep demot $BLOG)"
	! grep -q "UNKNOWN state" $BLOG || fail "INIT logged as an unknown state"
	;;
backup-follows-master)
	# Without preemption a member of better priority that comes back
	# stays backup: carp(4) has elected the other, so it must take the
	# configuration of that master, whose priority is worse.  The
	# Makefile runs this only with net.inet.carp.preempt=0.
	setup default
	start_backup
	start_master $INTERNAL.2
	retry gateway_is $INTERNAL.2 || fail "gateway not changed to $INTERNAL.2"
	run ifconfig carp$RM down
	retry carp_is carp$RB MASTER || fail "carp$RB did not become MASTER"
	run ifconfig carp$RM up
	retry carp_is carp$RM BACKUP || fail "carp$RM did not become BACKUP"
	retry_for 15 gateway_is $PREFIX.250 $MSTATE ||
	    fail "member come back as backup did not take the master's -g: $(cat $MSTATE)"
	carp_is carp$RB MASTER || fail "carp$RB is no longer MASTER"
	stop_backup
	stop_master
	grep -q "Backup Gateway: $PREFIX.250\$" $MLOG ||
	    fail "taking the master's configuration not logged"
	;;
three-members)
	# A master and two backups, routed by the -x hook as ifstated(8)
	# would.  When the master dies, the backup of the better priority
	# takes over: it announces the provider's gateway it learned,
	# although its default route still goes via the old master.  The
	# other backup stays backup and must follow it, its hook routing via
	# the new master's -g; and in turn take over when that one dies too.
	# A cut off member models a dead one: taken down, carp(4) would bow
	# out, and both backups would become master at first.
	setup
	setup_third
	run route -T $RM -qn add default $PREFIX.254
	start_backup -g $INTERNAL.1 -x $HOOK
	start_third -x $HOOK
	start_master $INTERNAL.2 -x $HOOK
	for s in $BSTATE $TSTATE; do
		retry gateway_is $INTERNAL.2 $s ||
		    fail "$s: $(cat $s 2>/dev/null)"
	done
	retry route_is $INTERNAL.2 $RB || fail "backup routes via $(defroute $RB)"
	retry route_is $INTERNAL.2 $RT || fail "third routes via $(defroute $RT)"
	retry route_is $PREFIX.254 $RM || fail "master routes via $(defroute $RM)"

	run ifconfig veb77 del vport$RM
	retry carp_is carp$RB MASTER || fail "carp$RB did not become MASTER"
	retry route_is $PREFIX.254 $RB ||
	    fail "new master routes via $(defroute $RB): $(cat $BSTATE)"
	retry_for 15 gateway_is $INTERNAL.1 $TSTATE ||
	    fail "third did not follow the new master: $(cat $TSTATE)"
	[ "$(state DCARP_GATEWAY $TSTATE)" = $PREFIX.254 ] ||
	    fail "new master announced no provider's gateway: $(cat $TSTATE)"
	retry route_is $INTERNAL.1 $RT || fail "third routes via $(defroute $RT)"
	carp_is carp$RT BACKUP || fail "carp$RT is not BACKUP"

	run ifconfig veb77 del vport$RB
	retry carp_is carp$RT MASTER || fail "carp$RT did not become MASTER"
	retry route_is $PREFIX.254 $RT ||
	    fail "last master routes via $(defroute $RT): $(cat $TSTATE)"
	[ "$(hook_log $TSTATE)" = "BACKUP/$INTERNAL.2 BACKUP/$INTERNAL.1 MASTER/$PREFIX.254" ] ||
	    fail "third's hook routed $(hook_log $TSTATE)"
	kill $tpid 2>/dev/null || fail "third dcarpd died"
	wait $tpid 2>/dev/null
	tpid=
	stop_backup
	stop_master
	;;
backup-gateway-kept)
	# A member keeps the backup gateway it learned from the master, -g
	# of the master, when it is master itself and after a restart: when
	# it falls back to backup, ifstated(8) routes via it at once, before
	# a message of the new master arrives.  Its own -g is no use to it.
	setup default
	start_backup
	master $PREFIX.254 || fail "gateway not changed to $PREFIX.254"
	stop_backup
	start_backup
	run ifconfig carp$RB state master
	retry grep -q "wrote $BSTATE: .* backup gateway" $BLOG ||
	    fail "backup forced to master did not write its state file"
	stop_backup
	gw=$(state DCARP_BACKUP_GATEWAY)
	[ "$gw" = $PREFIX.254 ] ||
	    fail "backup gateway $gw as master after a restart, not $PREFIX.254"
	;;
stale)
	# A recorded message is rejected once it is too old, also by a
	# backup that has never seen its sender.
	setup default
	start_backup
	capture
	master $PREFIX.254 || fail "gateway not changed to $PREFIX.254"
	wait_capture
	stop_backup
	sleep $((MAX_AGE + 2))
	start_backup
	replay
	sleep 2
	stop_backup
	rejected $PREFIX.$RA "timestamp [0-9]* seconds old" ||
	    fail "stale message not logged"
	;;
restore-address)
	# A backup puts back the address it holds when something else
	# removes it, as dhcpleased(8) does at the expiry of a lease that it
	# bound as master.  carp(4) authenticates its advertisements over the
	# addresses: without it the backup becomes master beside the master
	# after master-down, here 3 x (1 + 100/256) seconds.  With an IPv6
	# link-local address, as "inet6 eui64" gives, the interface stays up
	# and backup without its IPv4 address.
	setup default
	run ifconfig carp$RB inet6 eui64
	run ifconfig carp$RM inet6 eui64
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	retry carp_is carp$RB BACKUP || fail "carp$RB is not BACKUP"
	run ifconfig carp$RB $PREFIX.77 delete
	sleep 6
	only_address carp$RB $PREFIX.77 ||
	    fail "carp$RB has $(addresses carp$RB), not $PREFIX.77"
	carp_is carp$RB BACKUP || fail "carp$RB is not BACKUP"
	stop_backup
	stop_master
	! grep -q "CARP state changed to MASTER" $BLOG ||
	    fail "backup became MASTER without its address"
	grep -q "restoring $PREFIX.77" $BLOG ||
	    fail "putting the address back not logged"
	;;
restore-on-start)
	# A backup's dcarpd that starts while the carp interface has lost
	# its address puts back the one its state file holds.  An advbase of
	# 10 gives the backup a master-down time of half a minute to start in.
	setup default
	run ifconfig carp$RB inet6 eui64 advbase 10
	run ifconfig carp$RM inet6 eui64
	start_backup
	master $PREFIX.254 || fail "gateway not changed to $PREFIX.254"
	stop_backup
	retry carp_is carp$RB BACKUP || fail "carp$RB is not BACKUP"
	run ifconfig carp$RB $PREFIX.77 delete
	carp_is carp$RB BACKUP || fail "carp$RB without its address not BACKUP"
	start_backup
	retry_for 3 only_address carp$RB $PREFIX.77 ||
	    fail "carp$RB has $(addresses carp$RB), not $PREFIX.77"
	sleep 2
	carp_is carp$RB BACKUP || fail "carp$RB is not BACKUP"
	stop_backup
	grep -q "restoring $PREFIX.77" $BLOG ||
	    fail "putting the address back not logged"
	# At start, before the state is logged, not by the check every 10 s
	sed -n '/restoring/,$p' $BLOG | grep -q "carp$RB is in BACKUP state" ||
	    fail "address not put back at start"
	;;
restore-address-v4)
	# As restore-address, without an IPv6 address: losing its last
	# address takes the interface down, to INIT, where the backup would
	# stay without an address, receiving no messages from the master.
	setup default
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	retry carp_is carp$RB BACKUP || fail "carp$RB is not BACKUP"
	run ifconfig carp$RB $PREFIX.77 delete
	retry_for 3 only_address carp$RB $PREFIX.77 ||
	    fail "carp$RB has $(addresses carp$RB), not $PREFIX.77"
	retry carp_is carp$RB BACKUP || fail "carp$RB is not BACKUP"
	stop_backup
	stop_master
	grep -q "restoring $PREFIX.77" $BLOG ||
	    fail "putting the address back not logged"
	;;
restore-on-up)
	# A backup that comes back up without its address, e.g. after
	# dhcpleased(8) removed it while the interface was down, puts it
	# back as it becomes backup again, before carp(4) makes it master
	# beside the master.  With an IPv6 link-local address carp takes it
	# up without its IPv4 address.
	setup default
	run ifconfig carp$RB inet6 eui64
	run ifconfig carp$RM inet6 eui64
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	retry carp_is carp$RB BACKUP || fail "carp$RB is not BACKUP"
	seen=$(grep -c "CARP state changed to INIT" $BLOG)
	run ifconfig carp$RB down
	retry logged_more "CARP state changed to INIT" $BLOG $seen ||
	    fail "backup dcarpd did not see carp$RB in INIT"
	run ifconfig carp$RB $PREFIX.77 delete
	sleep 1
	[ -z "$(addresses carp$RB)" ] ||
	    fail "carp$RB in INIT got $(addresses carp$RB) back"
	run ifconfig carp$RB up
	retry_for 3 only_address carp$RB $PREFIX.77 ||
	    fail "carp$RB has $(addresses carp$RB), not $PREFIX.77"
	sleep 5
	carp_is carp$RB BACKUP || fail "carp$RB is not BACKUP"
	stop_backup
	stop_master
	! grep -q "CARP state changed to MASTER" $BLOG ||
	    fail "backup became MASTER without its address"
	;;
replace-on-backup)
	# A backup's address replaced from outside, removed and followed by
	# another address in a moment, is a new address from outside, not one
	# to put back: a new generation, which wins everywhere.
	setup default
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	retry carp_is carp$RB BACKUP || fail "carp$RB is not BACKUP"
	run ifconfig carp$RB $PREFIX.77 delete
	sleep 0.05
	run ifconfig carp$RB inet $PREFIX.88/24 alias
	sleep 1
	only_address carp$RB $PREFIX.88 ||
	    fail "carp$RB has $(addresses carp$RB), not only $PREFIX.88"
	retry_for 15 only_address carp$RM $PREFIX.88 ||
	    fail "carp$RM has $(addresses carp$RM), not only $PREFIX.88"
	stop_backup
	stop_master
	! grep -q "restoring" $BLOG || fail "replaced address put back"
	grep -q "address of carp$RB changed to $PREFIX.88" $BLOG ||
	    fail "new address from outside not logged"
	;;
restore-master)
	# The master never puts its address back: there it follows the DHCP
	# lease.  With an IPv6 link-local address the interface stays master
	# without its IPv4 address.
	setup default
	run ifconfig carp$RM inet6 eui64
	start_master $PREFIX.254
	retry grep -q "^sent " $MLOG || fail "master did not send"
	run ifconfig carp$RM $PREFIX.77 delete
	sleep 3
	carp_is carp$RM MASTER || fail "carp$RM without its address not MASTER"
	[ -z "$(addresses carp$RM)" ] || fail "carp$RM has $(addresses carp$RM)"
	stop_master
	! grep -q "restoring" $MLOG || fail "master put its address back"
	;;
state-generation)
	# A member starts with the generation of the configuration its state
	# file holds, not with the time of the DHCP lease file of its carp
	# interface: dhcpleased(8) writes that file when it binds a lease,
	# not when it renews it, so a backup's, e.g. one left by a blink, can
	# be newer than the master's generation, and the backup rejected the
	# master.
	setup default
	[ -d /var/db/dhcpleased ] || { echo "no /var/db/dhcpleased"; \
	    echo SKIPPED; cleanup; exit 0; }
	[ ! -e /var/db/dhcpleased/carp$RB ] ||
	    fail "/var/db/dhcpleased/carp$RB exists"
	leasefile=/var/db/dhcpleased/carp$RB
	run touch $leasefile
	gen=$(($(date +%s) - 3600))
	statefile $BSTATE $PREFIX.77 $gen
	statefile $MSTATE $PREFIX.77 $((gen + 100))
	start_backup
	master $PREFIX.254 ||
	    fail "backup did not take the master's newer generation"
	generation_is $((gen + 100)) || fail "state file: $(cat $BSTATE)"
	stop_backup
	grep -q "generation $gen from $BSTATE" $BLOG ||
	    fail "generation from the state file not logged"
	# A master of an older generation than the one held is rejected
	statefile $MSTATE $PREFIX.77 $gen
	start_backup
	! master $PREFIX.253 || fail "backup took an older generation"
	stop_backup
	rejected $PREFIX.77 "older configuration" ||
	    fail "older configuration not logged"
	;;
address-generation)
	# A new address from outside is a new generation, later than the
	# one held even if that is ahead of the clock, e.g. taken from a
	# member whose clock is ahead: it must win everywhere.
	setup default
	gen=$(($(date +%s) + 3600))
	statefile $BSTATE $PREFIX.77 $gen
	statefile $MSTATE $PREFIX.77 $gen
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	run ifconfig carp$RM inet $PREFIX.78/24
	retry_for 15 only_address carp$RB $PREFIX.78 ||
	    fail "carp$RB has $(addresses carp$RB), not only $PREFIX.78"
	[ "$(state DCARP_GENERATION)" -gt $gen ] ||
	    fail "generation $(state DCARP_GENERATION), not after $gen"
	stop_backup
	stop_master
	;;
renew)
	# As master, dcarpd reads the DHCP lease of its carp interface from
	# dhcpleased(8)'s control socket, as "dhcpleasectl -l" does, and
	# never asks it for a new lease.  When the lease was acknowledged is
	# the generation, so a renewal, which keeps the address, is a new
	# generation, which the master sends within a resend interval.
	setup default
	now=$(date +%s)
	lease Bound $PREFIX.77 255.255.255.0 86400 $((now - 600))
	start_dhcpleased
	start_backup
	start_master $PREFIX.254
	retry generation_is $((now - 600)) ||
	    fail "generation $(state DCARP_GENERATION), not the lease's $((now - 600))"
	lease Bound $PREFIX.77 255.255.255.0 86400 $((now - 60))
	retry_for 15 generation_is $((now - 60)) ||
	    fail "renewal not sent: generation $(state DCARP_GENERATION), not $((now - 60))"
	stop_backup
	stop_master
	stop_dhcpleased
	grep -q "^IMSG_CTL_SHOW_INTERFACE_INFO len 4\$" $FLOG ||
	    fail "dhcpleased not asked for the lease"
	! grep -v "^IMSG_CTL_SHOW_INTERFACE_INFO len 4\$" $FLOG ||
	    fail "dhcpleased asked for more: $(grep -v '^IMSG_CTL_SHOW_INTERFACE_INFO len 4$' $FLOG)"
	;;
lease-time)
	# The master sends how long its DHCP lease lasts with the
	# configuration, and the members write that, and when the lease runs
	# out, to their state files: empty without a lease.
	setup default
	now=$(date +%s)
	lease Bound $PREFIX.77 255.255.255.0 86400 $((now - 600))
	start_dhcpleased
	start_backup
	master $PREFIX.254 || fail "gateway not changed to $PREFIX.254"
	stop_backup
	[ "$(state DCARP_LEASE_TIME)" = 86400 ] || fail "state file: $(cat $BSTATE)"
	[ "$(state DCARP_LEASE_EXPIRES)" = $((now - 600 + 86400)) ] ||
	    fail "state file: $(cat $BSTATE)"
	[ "$(state DCARP_LEASE_TIME $MSTATE)" = 86400 ] ||
	    fail "master's state file: $(cat $MSTATE)"
	# A master that has no lease, from dhcpleased or held, sends none
	stop_dhcpleased
	rm -f $BSTATE $MSTATE
	start_backup
	master $PREFIX.253 || fail "gateway not changed to $PREFIX.253"
	stop_backup
	grep -q "^DCARP_LEASE_TIME=\$" $BSTATE &&
	    grep -q "^DCARP_LEASE_EXPIRES=\$" $BSTATE ||
	    fail "lease without a lease: $(cat $BSTATE)"
	;;
lease-size)
	# dhcpleased(8)'s control messages are internal to it, and change
	# with it: dcarpd takes an answer only of the size of the one it was
	# built with, and for its interface, and does not ask a dhcpleased
	# that answered otherwise again, which might take its request for
	# another.
	setup default
	now=$(date +%s)
	for wrong in "short 4" "long 4" "index 9999"; do
		lease Bound $PREFIX.77 255.255.255.0 86400 $((now - 600))
		echo "$wrong" >> $LEASE
		: > $FLOG
		seen=$(grep -c "not asking dhcpleased again" $MLOG)
		start_dhcpleased
		start_master $PREFIX.254
		retry logged_more "not asking dhcpleased again" $MLOG $seen ||
		    fail "$wrong: wrong answer not logged"
		sleep 11	# a resend
		stop_master
		stop_dhcpleased
		[ $(grep -c . $FLOG) -eq 1 ] ||
		    fail "$wrong: dhcpleased asked again: $(cat $FLOG)"
	done
	generation_is 0 $MSTATE ||
	    fail "generation from a wrong answer: $(cat $MSTATE)"
	grep -q "^DCARP_LEASE_TIME=\$" $MSTATE ||
	    fail "lease time from a wrong answer: $(cat $MSTATE)"
	[ $(grep -c "answer of [0-9]* bytes, expected" $MLOG) -eq 2 ] ||
	    fail "answers of the wrong size not logged"
	grep -q "answer for interface index 9999" $MLOG ||
	    fail "answer for another interface not logged"
	;;
lease-other)
	# A lease is the carp address's only if dhcpleased(8) has it bound,
	# or is renewing or rebinding it, for that address.
	setup default
	now=$(date +%s)
	lease Init $PREFIX.77 255.255.255.0 86400 $((now - 600))
	start_dhcpleased
	start_master $PREFIX.254
	retry grep -q "no DHCP lease: dhcpleased has $PREFIX.77 for carp$RM, Init" $MLOG ||
	    fail "lease in Init not refused"
	lease Bound $PREFIX.99 255.255.255.0 86400 $((now - 600))
	retry_for 15 grep -q "no DHCP lease: dhcpleased has $PREFIX.99 for carp$RM, Bound" $MLOG ||
	    fail "lease of another address not refused"
	printf 'end\n' > $LEASE.new && mv $LEASE.new $LEASE
	retry_for 15 grep -q "no DHCP lease: dhcpleased does not handle carp$RM" $MLOG ||
	    fail "interface dhcpleased does not handle not logged"
	generation_is 0 $MSTATE || fail "generation without a lease: $(cat $MSTATE)"
	lease Rebinding $PREFIX.77 255.255.255.0 86400 $((now - 600))
	retry_for 15 generation_is $((now - 600)) $MSTATE ||
	    fail "lease being rebound not taken: $(cat $MSTATE)"
	stop_master
	stop_dhcpleased
	;;
lease-silent)
	# A dhcpleased(8) that does not answer, e.g. one that takes the
	# request for another, is not asked again until SIGHUP.
	setup default
	now=$(date +%s)
	lease Bound $PREFIX.77 255.255.255.0 86400 $((now - 600))
	echo silent >> $LEASE
	start_dhcpleased
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	sleep 12	# a resend
	[ $(grep -c . $FLOG) -eq 1 ] ||
	    fail "dhcpleased asked again without an answer: $(cat $FLOG)"
	kill -HUP $mpid
	retry_for 15 logged_more . $FLOG 1 ||
	    fail "dhcpleased not asked again after SIGHUP"
	stop_backup
	stop_master
	stop_dhcpleased
	grep -q "no answer" $MLOG || fail "no answer not logged"
	generation_is 0 || fail "generation without an answer: $(cat $BSTATE)"
	;;
lease-future)
	# A lease that dhcpleased(8) reports acknowledged later than now
	# would give a generation that no later one could beat: dcarpd
	# rejects such an answer.
	setup default
	now=$(date +%s)
	lease Bound $PREFIX.77 255.255.255.0 86400 $((now + 3600))
	start_dhcpleased
	start_backup
	master $PREFIX.254 || fail "gateway not changed to $PREFIX.254"
	stop_backup
	stop_dhcpleased
	generation_is 0 || fail "generation from the future: $(cat $BSTATE)"
	grep -q "acknowledged in the future" $MLOG ||
	    fail "lease from the future not logged"
	;;
renew-ahead)
	# Each acknowledgement of the lease is a new generation, later than
	# the one held even if that is ahead of the clock, e.g. taken from a
	# member whose clock is ahead, and the lease time sent is that from
	# the generation on, so that the members know when the lease runs
	# out.
	setup default
	now=$(date +%s)
	gen=$((now + 3600))
	statefile $BSTATE $PREFIX.77 $gen
	statefile $MSTATE $PREFIX.77 $gen
	lease Bound $PREFIX.77 255.255.255.0 86400 $((now - 600))
	start_dhcpleased
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	generation_is $gen || fail "generation $(state DCARP_GENERATION), not $gen"
	[ "$(state DCARP_LEASE_EXPIRES)" = $((now - 600 + 86400)) ] ||
	    fail "lease runs out at $(state DCARP_LEASE_EXPIRES), not $((now - 600 + 86400))"
	lease Bound $PREFIX.77 255.255.255.0 86400 $((now - 60))
	retry_for 15 generation_is $((gen + 1)) ||
	    fail "renewal not a new generation: $(state DCARP_GENERATION)"
	[ "$(state DCARP_LEASE_EXPIRES)" = $((now - 60 + 86400)) ] ||
	    fail "renewed lease runs out at $(state DCARP_LEASE_EXPIRES), not $((now - 60 + 86400))"
	[ "$(state DCARP_LEASE_TIME)" = $((now - 60 + 86400 - gen - 1)) ] ||
	    fail "lease time $(state DCARP_LEASE_TIME) from generation $((gen + 1))"
	stop_backup
	stop_master
	stop_dhcpleased
	;;
sigint)
	# SIGINT stops dcarpd as SIGTERM does.
	setup default
	start_backup
	kill -INT $bpid
	retry_for 5 grep -q "terminated by SIGINT" $BLOG ||
	    fail "SIGINT not logged"
	retry_for 5 exited $bpid || fail "backup dcarpd did not stop on SIGINT"
	wait $bpid 2>/dev/null
	bpid=
	;;
start-fails)
	# dcarpd refuses an interface that is not carp(4), at start, and
	# demotes nothing.
	setup default
	allbefore=$(demote all)
	run ifconfig vether77 create
	run ifconfig vether77 rdomain $RB
	run ifconfig vether77 up
	route -T $RB exec $DCARPD -d -v -i vether77 -k $KEY -f $BSTATE -c $CTL \
	    > $BLOG 2>&1 &
	bpid=$!
	retry_for 5 exited $bpid || fail "dcarpd started on vether77"
	wait $bpid && fail "dcarpd on vether77 exited with 0"
	bpid=
	grep -q "vether77: not a carp(4) interface" $BLOG ||
	    fail "refusing vether77 not logged: $(cat $BLOG)"
	demote_is vether 0 || fail "group vether demoted: $(demote vether)"
	demote_is all $allbefore || fail "group all demoted: $(demote all)"
	;;
desync)
	# When its routing socket overflows, dcarpd gets RTM_DESYNC instead
	# of the messages lost, and catches up with the kernel: here the
	# backup became master, cut off from the master, while dcarpd was
	# stopped and its socket full.  Its 256 KB take some 1400 pairs of
	# address messages of 96 bytes.
	setup default
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	kill -STOP $bpid
	i=0
	while [ $i -lt 2000 ]; do
		ifconfig vport79 alias $INTERNAL.100/32
		ifconfig vport79 -alias $INTERNAL.100
		i=$((i + 1))
	done
	run ifconfig veb77 del vport$RB
	retry carp_is carp$RB MASTER || fail "cut off carp$RB did not become MASTER"
	kill -CONT $bpid
	retry_for 5 grep -q "CARP state changed to MASTER" $BLOG ||
	    fail "backup dcarpd did not see carp$RB become MASTER"
	retry grep -q "routing messages lost" $BLOG ||
	    fail "lost routing messages not logged"
	stop_backup
	stop_master
	! grep -q "unexpected routing message" $BLOG ||
	    fail "RTM_DESYNC taken for an unexpected message"
	;;
reject-repeat)
	# A sender that keeps resending a configuration that is rejected,
	# here an older one, is logged once, not at every resend.
	# Another rejection logged meanwhile, of the same sender, changes
	# nothing.
	setup default
	(umask 077; echo another-key > $KEY.other) || fail "cannot write key"
	statefile $BSTATE $PREFIX.77 $(($(date +%s) + 3600))
	start_backup
	start_master $PREFIX.254
	retry rejected $PREFIX.77 "older configuration" ||
	    fail "older configuration not rejected"
	sleep 25	# two more resends
	stop_master
	start_master $PREFIX.254 -k $KEY.other
	retry_for 15 rejected $PREFIX.77 "authentication failed" ||
	    fail "another rejection of the same sender not logged"
	stop_master
	sleep 11	# past the limit for any rejection
	# The same rejection of another sender is logged
	dd if=/dev/zero of=$MSG bs=104 count=1 2>/dev/null
	replay
	retry rejected $PREFIX.$RA "authentication failed" ||
	    fail "the same rejection of another sender not logged"
	sleep 11
	start_master $PREFIX.254
	sleep 12	# a resend
	stop_backup
	stop_master
	count=$(grep -c "rejected message from $PREFIX.77: older configuration" $BLOG)
	[ $count -eq 1 ] || fail "older configuration logged $count times"
	;;
start-errors)
	# Errors at start reach the terminal, naming the file, and dcarpd
	# exits with an error, also without -d.
	setup default
	route -T $RB exec $DCARPD -i carp$RB -k $OBJDIR/nonexistent.key \
	    -f $BSTATE -c $CTL > $BLOG 2>&1 && fail "dcarpd started without its key"
	grep -q "$OBJDIR/nonexistent.key" $BLOG ||
	    fail "key file not named: $(cat $BLOG)"
	;;
state-retry)
	# A master whose state file could not be written writes it at its
	# next resend.
	setup default
	rm -rf $DIR
	route -T $RM exec $DCARPD -d -v -i carp$RM -g $PREFIX.254 -k $KEY \
	    -f $DIR/master.state -c $CTL > $MLOG 2>&1 &
	mpid=$!
	retry listening $mpid || fail "master dcarpd did not start"
	retry grep -q "^sent " $MLOG || fail "master did not send"
	[ ! -e $DIR/master.state ] || fail "state file written without its directory"
	run mkdir $DIR
	retry_for 15 test -s $DIR/master.state ||
	    fail "state file not written at the next resend"
	stop_master
	;;
carp-copies)
	# carp(4) hands every multicast datagram on its carpdev to every
	# carp interface there: dcarpd drops the copies of the master's
	# messages that another carp interface delivers, without logging
	# them as rejected.
	setup default
	mkcarp carp88 $RB vport$RB 188 100 $PREFIX.88/24
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	sleep 12	# a resend
	stop_backup
	stop_master
	grep -q "dropped a copy received on carp88" $BLOG ||
	    fail "no copy on carp88 seen"
	! grep -q "rejected message .*received on carp88" $BLOG ||
	    fail "copy on carp88 rejected: $(grep 'received on carp88' $BLOG | head -1)"
	;;
key-mode)
	# The key file must be a regular file without any permission for
	# group or others: one that they can read or write is refused.
	setup default
	for mode in 640 604 620 602 610 601; do
		run chmod $mode $KEY
		route -T $RB exec $DCARPD -d -v -i carp$RB -g $PREFIX.250 \
		    -k $KEY -f $BSTATE -c $CTL > $BLOG 2>&1 &
		bpid=$!
		retry_for 3 grep -q "$KEY: accessible by group or others" \
		    $BLOG || fail "key file of mode $mode not refused"
		retry_for 5 exited $bpid ||
		    fail "dcarpd runs with a key file of mode $mode"
		wait $bpid 2>/dev/null
		bpid=
	done
	;;
second-daemon)
	# One dcarpd per routing domain: a second one fails before it
	# becomes a daemon, with the error on the terminal.
	setup default
	start_backup
	route -T $RB exec $DCARPD -i carp$RB -k $KEY -f $BSTATE.2 -c $CTL \
	    > $TLOG 2>&1 && fail "second dcarpd started"
	grep -q "Address already in use" $TLOG ||
	    fail "bind failure not reported: $(cat $TLOG)"
	stop_backup
	;;
short-messages)
	# Address messages of other interfaces, e.g. of lo(4), are shorter
	# than a routing message header: no error.
	setup default
	start_backup
	run ifconfig lo$RB alias 127.0.0.2/32
	run ifconfig lo$RB -alias 127.0.0.2
	sleep 1
	stop_backup
	! grep -E -q "too short|too small" $BLOG ||
	    fail "short routing message logged: $(grep -E 'too short|too small' $BLOG)"
	;;
interface-gone)
	# A carp interface created anew gets another index, of which dcarpd
	# would hear nothing: when its interface is destroyed, it exits.
	setup default
	start_backup
	# Not for any interface
	run ifconfig vether77 create
	run ifconfig vether77 destroy
	sleep 1
	! exited $bpid || fail "backup dcarpd exited when vether77 was destroyed"
	run ifconfig carp$RB destroy
	retry_for 5 grep -q "carp$RB was destroyed: exiting" $BLOG ||
	    fail "destroying carp$RB not logged"
	retry_for 5 exited $bpid ||
	    fail "backup dcarpd did not exit when carp$RB was destroyed"
	wait $bpid 2>/dev/null
	bpid=
	# The same for the sync interface
	mkcarp carp$RB $RB vport$RB $VHID 100 $PREFIX.77/24
	start_backup -s vport79
	run ifconfig vport79 destroy
	retry_for 5 grep -q "vport79 was destroyed: exiting" $BLOG ||
	    fail "destroying vport79 not logged"
	retry_for 5 exited $bpid ||
	    fail "backup dcarpd did not exit when vport79 was destroyed"
	wait $bpid 2>/dev/null
	bpid=
	;;
two-addresses)
	# carp(4) authenticates over all the addresses of the interface: a
	# master whose carp interface has two IPv4 addresses sends neither,
	# and says so.
	setup default
	start_backup
	start_master $PREFIX.254
	retry gateway_is $PREFIX.254 ||
	    fail "gateway not changed to $PREFIX.254"
	sent=$(grep -c -E "^sent |^resent unchanged" $MLOG)
	run ifconfig carp$RM inet $PREFIX.66/24 alias
	retry_for 25 grep -q "carp$RM has 2 IPv4 addresses, not sending" $MLOG ||
	    fail "two addresses on carp$RM not logged"
	[ $(grep -c -E "^sent |^resent unchanged" $MLOG) -eq $sent ] ||
	    fail "master sent with two addresses"
	stop_backup
	stop_master
	! grep -q "Received IP distribution message .*CARP IP: $PREFIX.66" $BLOG ||
	    fail "backup took the alias $PREFIX.66"
	;;
other-rdomain)
	# dcarpd hears the routing messages of its own routing domain only,
	# so it refuses an interface in another one.
	setup default
	$DCARPD -d -v -i carp$RB -k $KEY -f $BSTATE -c $CTL > $BLOG 2>&1 &
	bpid=$!
	retry_for 3 grep -q "carp$RB is in rdomain $RB" $BLOG ||
	    fail "carp$RB in rdomain $RB not refused: $(cat $BLOG)"
	retry_for 5 exited $bpid || fail "dcarpd runs for carp$RB from rdomain 0"
	wait $bpid 2>/dev/null
	bpid=
	# The sync interface too
	route -T $RB exec $DCARPD -d -v -i carp$RB -s vport89 -k $KEY \
	    -f $BSTATE -c $CTL > $BLOG 2>&1 &
	bpid=$!
	retry_for 3 grep -q "vport89 is in rdomain $RM" $BLOG ||
	    fail "vport89 in rdomain $RM not refused: $(cat $BLOG)"
	retry_for 5 exited $bpid || fail "dcarpd runs with vport89 from rdomain $RB"
	wait $bpid 2>/dev/null
	bpid=
	;;
*)
	echo "usage: dcarpd-test state-file | gateway-from-route | other-carp |" \
	    "log-live | replay | tampered | wrong-key | encrypted |" \
	    "sync-interface | periodic | address-change | split-brain |" \
	    "address-follow | older-generation | lower-priority |" \
	    "equal-priority | init-takes | no-address |" \
	    "backup-follows-master | three-members | backup-gateway-kept |" \
	    "stale | restore-address | restore-on-start | state-generation |" \
	    "address-generation | renew | lease-time | lease-size |" \
	    "lease-silent | lease-future | renew-ahead | restore-address-v4 |" \
	    "restore-master | lease-other | restore-on-up |" \
	    "replace-on-backup | sigint | start-fails | desync |" \
	    "reject-repeat | start-errors | state-retry | carp-copies |" \
	    "key-mode | second-daemon | short-messages | interface-gone |" \
	    "two-addresses | other-rdomain" >&2
	exit 2
	;;
esac

cleanup
exit 0
